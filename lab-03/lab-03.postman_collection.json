{
  "info": {
    "name": "Lab 3 REST API tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Success and failure test cases for the Lab 3 books API. Set baseUrl to the local server or the Render URL."
  },
  "item": [
    {
      "name": "Success cases",
      "item": [
        {
          "name": "01 GET all books (defaults: limit 10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is a list\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });",
                  "pm.test(\"At most 10 books\", function () { pm.expect(pm.response.json().length).to.be.at.most(10); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "02 GET one book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Book 3 returned\", function () { pm.expect(pm.response.json().id).to.eql(3); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/3/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "3"
              ]
            }
          }
        },
        {
          "name": "03 Search by title (search_q=the)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is a list\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });",
                  "pm.test(\"Every title contains the\", function () { pm.response.json().forEach(b => pm.expect(b.title.toLowerCase()).to.include(\"the\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?search_q=the",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "search_q",
                  "value": "the"
                }
              ]
            }
          }
        },
        {
          "name": "04 Sort by price descending",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is a list\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });",
                  "pm.test(\"Prices are descending\", function () { const p = pm.response.json().map(b => b.price); pm.expect(p).to.eql([...p].sort((a, b) => b - a)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?order_by=price&order=DESC&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "DESC"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
